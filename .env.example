# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cspm

# API Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Security Copilot Provider Configuration
# Supported options: 'gemini' (default) or 'deepseek'
AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek Configuration (optional if using deepseek provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# AWS Scan Options (optional - standard boto3 credentials or profile also supported)
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:4566  # LocalStack / emulator override

# Frontend Configuration (for frontend/.env)
# VITE_API_URL=http://localhost:8000
